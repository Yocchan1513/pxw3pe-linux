# Out-of-tree dvb-core for kernels built without CONFIG_DVB_CORE
# (RHEL / Rocky Linux 10). Sources: drivers/media/dvb-core from
# kernel-6.12.0-211.16.1.el10_2 (Rocky Linux 10.2 SRPM), unmodified.
# Kconfig defaults that the kernel's .config does not provide:
ccflags-y += -DCONFIG_DVB_MAX_ADAPTERS=16 -DCONFIG_DVB_DYNAMIC_MINORS=1

obj-m := dvb-core.o
dvb-core-objs := dvbdev.o dmxdev.o dvb_demux.o dvb_ca_en50221.o \
		 dvb_frontend.o dvb_ringbuffer.o
